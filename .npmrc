# Disable pnpm's self-management ("Checking for updates... Switching pnpm
# from vX to vY") — it reads packageManager from package.json and tries to
# self-upgrade on every invocation, which crashes on CI runners with a
# preinstalled pnpm version (Cannot use 'in' operator to search for
# 'integrity' in undefined). pnpm/action-setup already pins the exact
# version we want, so this feature is redundant here anyway.
manage-package-manager-versions=false
